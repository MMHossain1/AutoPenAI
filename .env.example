# ── Docker Build ──────────────────────────────────────
# Prevents a containerd layer-lock race when building multiple images in parallel
COMPOSE_PARALLEL_LIMIT=1

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=testpassword
POSTGRES_DB=sweng-11

# ── Ollama LLM ────────────────────────────────────────
# Profile: fast (0.8b), small (2b), medium (9b), large (27b)
LLM_PROFILE=fast
